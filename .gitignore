# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Disposable build output and caches, including nested packages.
# features/tomatojuice/runtime.js is a required browser entry, NOT disposable output.
dist/
build/
out/
.cache/
.parcel-cache/
.vite/
.turbo/
.rollup.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.js.map
*.mjs.map
*.css.map
/*.tgz

# Local-only tests, benchmarks, fixtures and helpers; keep them on disk, not in Git.
/test/
/tests/
/__tests__/
/benchmarks/

# Test results, coverage and browser automation artifacts
coverage/
.nyc_output/
test-results/
test-results.*
test-output/
test-artifacts/
benchmark-results/
playwright-report/
playwright/.cache/
blob-report/
allure-results/
allure-report/
junit.xml
junit-*.xml
*.lcov
*.cpuprofile
*.heapprofile

# Logs and temporary files
*.log
/tmp/
/temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Local editor and OS metadata
/.vscode/
/.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local environment secrets; retain example templates
.env
.env.*
!.env.example
!.env.sample

# Local Tomatojuice runtime data and user-specific backend configuration
/_st-toolbox/
/data/
/server-plugin/st-toolbox-server/tomatojuice.config.json

# Keep build sources/scripts, package.json and package-lock.json for reproducible builds.
# Keep features/tomatojuice/runtime.js: SillyTavern loads it without a user-side build.
# Keep runtime vendor scripts/workers, audio, icons and their notices tracked.
# Do not add broad rules such as vendor/, *.umd.js, *.mp3 or *.ico.
