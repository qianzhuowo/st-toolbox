build/
out/
.cache/
.parcel-cache/
.vite/
.turbo/
.rollup.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.js.map
*.mjs.map
*.css.map
*.cjs.map
/*.tgz

# Local-only tests, benchmarks, fixtures and helpers; keep them on disk, not in Git.
test/
tests/
__tests__/
benchmarks/
__fixtures__/
__snapshots__/
.fixtures/
*.test.js
*.test.mjs
*.test.cjs
*.test.ts
*.spec.js
*.spec.mjs
*.spec.cjs
*.spec.ts
*.bench.js
*.bench.mjs
*.bench.cjs
*.bench.ts

# Local cross-repository verification; not needed to build or run the extension.
/scripts/verify-tomatojuice-tt.mjs
/docs/tomatojuice-cache-validation.md
/docs/tomatojuice-tt-verification.md

